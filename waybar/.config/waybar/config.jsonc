{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 0,
    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "privacy",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "tray",
        "pulseaudio",
        "group/network",
        "group/cpu",
        "custom/power"
    ],

	"group/cpu": {
		"orientation": "horizontal",
		"modules": [
			"cpu",
			"memory",
            "custom/temperature"
		],
        "drawer": {
            "click-to-reveal": false
        }
	},

    "group/network": {
		"orientation": "horizontal",
		"modules": [
            "network#ethernet",
            "network#wifi",
            "bluetooth"
		]
	},

    "privacy": {
        "icon-spacing": 4,
        "icon-size": 18,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 24
            },
            {
                "type": "audio-out",
                "tooltip": true,
                "tooltip-icon-size": 24
            },
            {
                "type": "audio-in",
                "tooltip": true,
                "tooltip-icon-size": 24
            }
        ],
        "ignore-monitor": true,
        "ignore": [
            {
                "type": "audio-in",
                "name": "cava"
            },
            {
                "type": "screenshare",
                "name": "obs"
            }
        ]
    },

    "custom/arch": {
        "format": "<span font_family='JetBrainsMono Nerd Font' color='#FFC212'>  </span>",
        "tooltip": true,
        "tooltip-format": "Arch Linux",
        "on-click": "wofi -n --conf ~/.config/wofi/config --style ~/.config/wofi/style.css --show drun"
    },

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{icon}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"-1\" })'",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4]
        },
        "format-icons": {
            "1": "  ",
            "2": "  ",
            "3": " 󱞎 ",
            "4": "  ",
            "default": "  "
        }
    },

    "hyprland/window" : {
        "format": " {title} ",
        "icon": true,
        "max-length": 40,
        "separate-outputs": false
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    },

    "custom/power": {
        "format": "<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'>  </span>",
        "on-click": "~/.config/bin/powermenu.sh",
        "tooltip": true
    },

    "network#wifi": {
        "interface": "wl*",
        "format-wifi": "<span font_family='JetBrainsMono Nerd Font' color='#E0DFFD'> 󰤨 </span>",
        "format-linked": "<span font_family='JetBrainsMono Nerd Font' color='#FFC212'> 󱘖 </span>",
        "format-disconnected": "<span font_family='JetBrainsMono Nerd Font' color='#EF6D6C'> 󰤮 </span>",
        "format-disabled": "",
        "tooltip-format": "<span font_family='JetBrainsMono Nerd Font' color='#6455A4'> 󰅧 </span>{bandwidthUpBytes}  <span font_family='JetBrainsMono Nerd Font' color='#6455A4'> 󰅢 </span>{bandwidthDownBytes}",
        "on-click": "pgrep -x nmtui >/dev/null && pkill -x nmtui || hyprctl dispatch 'hl.dsp.exec_cmd(\"kitty -e nmtui\", { float = true, size = \"monitor_w*0.3 monitor_h*0.5\", move = \"monitor_w*0.69 monitor_h*0.03\" })'",
        "interval": 1
    },

    "network#ethernet": {
        "interface": "eno1",
        "format-ethernet": "<span font_family='JetBrainsMono Nerd Font' color='#E0DFFD'> 󰈁 </span>",
        "format-linked": "<span font_family='JetBrainsMono Nerd Font' color='#FFC212'> 󱘖 </span>",
        "format-disconnected": "",
        "tooltip-format": "<span font_family='JetBrainsMono Nerd Font' color='#6455A4'> 󰅧 </span>{bandwidthUpBytes}  <span font_family='JetBrainsMono Nerd Font' color='#6455A4'> 󰅢 </span>{bandwidthDownBytes}",
        "interval": 1
    },

    "pulseaudio": {
        "format": "<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'>{icon}</span>{volume}% ",
        "format-muted": "<span font_family='JetBrainsMono Nerd Font' color='#EF6D6C'> 󰖁 </span>0% ",
        "format-icons": {
            "headphone": "<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'>  </span>",
            "hands-free": "<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'>  </span>",
            "headset": "<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'>  </span>",
            "phone": "<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'>  </span>",
            "portable": "<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'>  </span>",
            "car": "<span font_family='JetBrainsMono Nerd Font' color='#FFC212'>  </span>",
            "default": [
                "<span font_family='JetBrainsMono Nerd Font' color='#E0DFFD'>  </span>",
                "<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'>  </span>",
                "<span font_family='JetBrainsMono Nerd Font' color='#FFC212'>  </span>"
            ]
        },
        "on-click": "pgrep -x wiremix >/dev/null && pkill wiremix || hyprctl dispatch 'hl.dsp.exec_cmd(\"kitty -e wiremix --tab output\", { float = true, size = \"monitor_w*0.3 monitor_h*0.5\", move = \"monitor_w*0.69 monitor_h*0.03\" })'",
        "tooltip": true,
        "tooltip-format": "{volume}%"
    },

    "custom/temperature": {
        "exec": "~/.config/bin/temprature.sh",
        "format": "<span font_family='JetBrainsMono Nerd Font' color='#FFC212'>  </span>{text}°C ",
        "interval": 5,
        "tooltip": true,
        "return-type": "json"
    },

    "memory": {
        "format": "<span font_family='JetBrainsMono Nerd Font' color='#FFC212'>   </span>{used:0.2f}G/{total:0.2f}G ",
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "Swap {swapUsed}G/{swapTotal}G"
    },

    "cpu": {
        "format": "<span font_family='JetBrainsMono Nerd Font' color='#FFC212'>  </span>{usage}% ",
        "on-click": "pgrep -x btop >/dev/null && pkill btop || hyprctl dispatch 'hl.dsp.exec_cmd(\"kitty -e btop\", { float = true, size = \"monitor_w*0.4 monitor_h*0.7\", move = \"monitor_w*0.59 monitor_h*0.03\" })'",
        "tooltip": true
    },

    "clock": {
        "interval": 60,
        "timezone": "Asia/Kolkata",
        "format": "<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'>  </span>{:%a %d %b<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'>  </span>%H:%M} ",
        "tooltip": true,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<b>{}</b>",
                "weekdays": "<span color='#9C8FD6'><b>{}</b></span>",
                "today": "<span color='#EF6D6C'><b><u>{}</u></b></span>"
            }
        }
    },

    "bluetooth": {
        "format": "<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'>  </span>",
        "format-connected": "<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'> 󰂱 </span>",
        "format-disabled": "<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'> 󰂲 </span>",
        "format-connected-battery": "<span font_family='JetBrainsMono Nerd Font' color='#F9B0C3'> 󰂱 </span>{device_battery_percentage}% ",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "on-click": "pgrep -x bluetui >/dev/null && pkill bluetui || hyprctl dispatch 'hl.dsp.exec_cmd(\"kitty -e bluetui\", { float = true, size = \"monitor_w*0.3 monitor_h*0.5\", move = \"monitor_w*0.69 monitor_h*0.03\" })'"
    }
}

