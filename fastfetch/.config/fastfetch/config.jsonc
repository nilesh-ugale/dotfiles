{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // "type": "file",
    // "source": "~/.config/omarchy/branding/about.txt",
    "color": { "1": "blue" },
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "green",
      "format": "{width}x{height} in 32\", {refresh-rate} Hz [{type}]"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "└ └󰓡 ",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "key": " OS",
      "keyColor": "blue",
      "type": "os"
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "blue",
      // dotfiles branch, last commit, and whether there are uncommitted changes
      "text": "b=$(git -C ~/dotfiles rev-parse --abbrev-ref HEAD); h=$(git -C ~/dotfiles log -1 --format=%h); [ -z \"$(git -C ~/dotfiles status --porcelain)\" ] && s=clean || s=dirty; echo \"dotfiles $b @ $h ($s)\""
    },
    {
      "type": "command",
      "key": "│ ├󰔫",
      "keyColor": "blue",
      // testing if any *-testing repo is enabled, otherwise stable
      "text": "r=$(pacman-conf --repo-list | paste -sd, -); case $r in *testing*) c=testing;; *) c=stable;; esac; echo \"$c ($r)\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "blue"
    },
    {
      "type": "colors",
      "key": "│ ├󰸌",
      "keyColor": "blue",
      "symbol": "circle"
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "magenta",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "magenta",
      // date of the last pacman -Syu
      "text": "d=$(grep 'starting full system upgrade' /var/log/pacman.log | tail -1 | cut -c2-11); echo \"$d ($(( ($(date +%s) - $(date -d \"$d\" +%s)) / 86400 )) days ago)\""
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
